// Prisma schema — selaras ERD Pak Resto UNIKOM
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ ENUMS ============

enum Role {
  PELAYAN
  CHEF
  KASIR
  MANAJER
}

enum TipePesanan {
  DINE_IN
  TAKEAWAY
}

enum StatusPesanan {
  MENUNGGU
  DIPROSES
  SIAP
  DIANTAR
  SELESAI
  DIBATALKAN
}

enum StatusMeja {
  KOSONG
  TERISI
  RESERVED
}

enum StatusMenu {
  AKTIF
  NONAKTIF
}

enum StatusBahan {
  TERSEDIA
  MENIPIS
  HABIS
}

enum MetodePembayaran {
  CASH
  QRIS
  TRANSFER
}

enum StatusPembayaran {
  BELUM_BAYAR
  LUNAS
  DIBATALKAN
}

// ============ MODELS ============

model user {
  id_user      Int          @id @default(autoincrement())
  nama_lengkap String
  username     String       @unique
  password     String
  role         Role
  pesanan      pesanan[]
  pembayaran   pembayaran[]

  @@map("user")
}

model meja {
  id_meja    Int        @id @default(autoincrement())
  nomor_meja Int        @unique
  kapasitas  Int
  kode_qr    String     @unique
  status     StatusMeja @default(KOSONG)
  pesanan    pesanan[]

  @@map("meja")
}

model kategori {
  id_kategori  Int     @id @default(autoincrement())
  nama_kategori String
  deskripsi    String?
  warna        String?
  jumlah_menu  Int     @default(0)
  aktif        Boolean @default(true)
  menu         menu[]

  @@map("kategori")
}

model menu {
  id_menu         Int               @id @default(autoincrement())
  id_kategori     Int
  nama_menu       String
  deskripsi       String?
  harga           Int
  status          StatusMenu        @default(AKTIF)
  gambar          String?
  kategori        kategori          @relation(fields: [id_kategori], references: [id_kategori], onDelete: Cascade)
  detail_pesanan  detail_pesanan[]
  menu_bahan      menu_bahan[]

  @@index([id_kategori])
  @@map("menu")
}

model bahan_baku {
  id_bahan   Int         @id @default(autoincrement())
  nama_bahan String
  jumlah     Float
  satuan     String
  status     StatusBahan @default(TERSEDIA)
  menu_bahan menu_bahan[]

  @@map("bahan_baku")
}

model menu_bahan {
  id_bahan     Int
  id_menu      Int
  jumlah_pakai Float
  bahan_baku   bahan_baku @relation(fields: [id_bahan], references: [id_bahan], onDelete: Cascade)
  menu         menu       @relation(fields: [id_menu], references: [id_menu], onDelete: Cascade)

  @@id([id_bahan, id_menu])
  @@map("menu_bahan")
}

model pesanan {
  id_pesanan     Int              @id @default(autoincrement())
  id_user        Int
  id_meja        Int?
  tipe_pesanan   TipePesanan
  waktu_pesanan  DateTime         @default(now())
  status_pesanan StatusPesanan    @default(MENUNGGU)
  total_harga    Int
  user           user             @relation(fields: [id_user], references: [id_user])
  meja           meja?            @relation(fields: [id_meja], references: [id_meja])
  detail_pesanan detail_pesanan[]
  pembayaran     pembayaran?

  @@index([id_user])
  @@index([id_meja])
  @@index([status_pesanan])
  @@map("pesanan")
}

model detail_pesanan {
  id_detail  Int     @id @default(autoincrement())
  id_menu    Int
  id_pesanan Int
  jumlah     Int
  catatan    String?
  subtotal   Int
  menu       menu    @relation(fields: [id_menu], references: [id_menu])
  pesanan    pesanan @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: Cascade)

  @@index([id_pesanan])
  @@index([id_menu])
  @@map("detail_pesanan")
}

model pembayaran {
  id_pembayaran     Int               @id @default(autoincrement())
  id_user           Int
  id_pesanan        Int               @unique
  metode_pembayaran MetodePembayaran
  waktu_pembayaran  DateTime          @default(now())
  total             Int
  status_pembayaran StatusPembayaran  @default(BELUM_BAYAR)
  user              user              @relation(fields: [id_user], references: [id_user])
  pesanan           pesanan           @relation(fields: [id_pesanan], references: [id_pesanan])

  @@index([id_user])
  @@map("pembayaran")
}
